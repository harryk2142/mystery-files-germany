---
import { BreakingNewsItems } from "./BreakingNewsItems";
---
<div id={"section-breaking-news-ticker"}>
    <div id={"breaking-news-ticker-header"} class="box">
        <span>NEWS</span>
    </div>
    <BreakingNewsItems client:visible/>
</div>
<style>
    #section-breaking-news-ticker {
        display: flex;
    }

    #breaking-news-ticker-header {
        display: flex;
        justify-content: center;
        font-weight: bold;
        color: var(--color-white);
        white-space: nowrap;
        background: var(--color-red);
    }
</style>

