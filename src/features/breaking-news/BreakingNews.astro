---
import Card from "@components/design-system/Card.astro";
import { BreakingNewsItems } from "./BreakingNewsItems";
---
<Card id={"section-breaking-news-ticker"}>
    <div id={"breaking-news-ticker-header"}>
        <span>BREAKING NEWS</span>
    </div>
    <div id={"ticker-container"}>
        <BreakingNewsItems client:visible/>
    </div>
</Card>
<style>

    #breaking-news-ticker-header {
        font-size: 1.5rem;
        font-weight: bold;
    }

    #ticker-container {
        width: 100%;
        overflow: hidden;
        white-space: nowrap;
    }

    @keyframes marquee {
        0% {
            transform: translateX(5%);
        }
        100% {
            transform: translateX(-100%);
        }
    }
</style>

