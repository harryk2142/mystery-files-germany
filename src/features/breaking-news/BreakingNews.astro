---
import Card from "@components/design-system/Card.astro";

import {BreakingNewsItems} from "./BreakingNewsItems";
---
<div id={"section-breaking-news-ticker"}>
    <div id={"breaking-news-ticker-header"}>
        <span>NEWS</span>
    </div>
    <BreakingNewsItems client:visible/>
</div>
<style>
  #section-breaking-news-ticker {
    display: flex;
    align-items: center;
    height: 4rem;
    overflow: hidden;
  }
  #breaking-news-ticker-header {
    display: flex;
    align-items: center;
    padding-inline: 1rem;
      height: 100%;
    font-weight: bold;
    color: var(--color-white);
    white-space: nowrap;
    background: var(--color-red);
  }
</style>

