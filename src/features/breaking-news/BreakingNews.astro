---
import Card from "@components/design-system/Card.astro";

import {BreakingNewsItems} from "./BreakingNewsItems";
---
<Card id={"section-breaking-news-ticker"}>
    <div id={"breaking-news-ticker-header"}>
        <span>BREAKING NEWS</span>
    </div>
    <BreakingNewsItems client:visible/>
</Card>
<style>
  #section-breaking-news-ticker {
    display: flex;
    align-items: center;
    height: 4rem;
    overflow: hidden;
  }
  #breaking-news-ticker-header {
    display: flex;
    align-items: center;
    padding-inline: 1rem;
    font-weight: bold;
    color: var(--color-text-secondary);
    white-space: nowrap;
    background: var(--color-black);
    border-radius: var(--radius-border);
  }
</style>

