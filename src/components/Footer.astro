---
import { Image } from 'astro:assets';
import copyright from "@assets/icons/by-nc-sa.eu.svg"
const getVersion = (date: Date) => {
    const mm = date.getMonth() + 1; // getMonth() is zero-based
    const dd = date.getDate();

    return [
        date.getFullYear(),
        (mm > 9 ? "" : "0") + mm,
        (dd > 9 ? "" : "0") + dd,
    ].join("");
};
const today = new Date();
const version = getVersion(today);
const isDev = import.meta.env.DEV;
---

<footer>
    <span>
        &copy; {today.getFullYear()} Kramer. V {version}
        {isDev && <span>DEV</span>}
    </span>
    <Image alt="Copyright Icon" src={copyright} />
</footer>
<style>
    footer {
        background-color: var(--color-primary);
        border: 1px solid lightgray;
        text-align: center;
        position: fixed;
        bottom: 0;
        width: 100%;
        font-size: 1rem;
        display: flex;
        justify-content: center;
        align-items: center;
        opacity: 0.9;

        :first-child {
            padding-right: 1rem;
        }
    }
</style>
<style is:inline>
    *:has(+ footer) {
        margin-bottom: 60px;
    }
</style>
