---
import PagefindConfig from "astro-pagefind/components/PagefindConfig.astro";

---

<section id="section-search">
    <!--<Search className="pagefind-ui"-->
    <!--        instance="search"-->
    <!--        searchboxOptions={{-->
    <!--            sort: {-->
    <!--                date: "asc"-->
    <!--            }, showImages: true, pageSize: 5, openFilters: ["Tags", "Type"]-->
    <!--        }}-->
    <!--/>-->
    <PagefindConfig />

    <pagefind-input></pagefind-input>
    <pagefind-summary></pagefind-summary>
    <pagefind-results hide-sub-results={true} show-images={true}></pagefind-results>
</section>
<style>
    :root {
        --pf-image-width: 100px;
        --pf-image-height: 100px;
        --pf-border: #008a00;
        --pf-ui-border-radius: 16px;
        --pf-ui-image-box-ratio: 1;
        --pf-ui-scale: 1;
        --pf-ui-text: var(--color-text);
        --pf-ui-font: "Open Sans", sans-serif;
        --pf-ui-background: "white";
        /* Sizing */
        --pf-input-height: 36px;
        --pf-input-font-size: 1rem; /* Keep at 16px+ to prevent iOS auto-zoom on focus */
        --pf-summary-font-size: 1rem;
        --pf-result-title-font-size: 1.2rem;
        --pf-result-excerpt-font-size: 1rem;
    }

    #section-search {
        background-color: #f4f4f4;
        border-radius: 16px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);

        input:hover, input:active, button:hover {
            background-color: lightgray;
        !important;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.5);
        }

        button {
            cursor: pointer;
            color: var(--color-primary);
            background-color: lightgray;
            font-size: 1.25rem;
            border: 1px solid lightgray;
            border-radius: 16px;
            display: inline-block;
            padding: 8px 16px;
            vertical-align: middle;
            text-decoration: none;
            text-align: center;
            white-space: nowrap;

            transition: box-shadow 0.2s, background-color 0.2s;
        }
    }
</style>
