---
import { Image } from "astro:assets";

type Props = {
    src: ImageMetadata,
    alt: string,
}

const { src, alt = "" } = Astro.props;
---
<div class="image-frame">
    <div class="blur-bg" style={`background-image: url(${src.src});`}></div>
    <Image src={src} alt={alt} format="webp" />
</div>

<style>
  .image-frame {
    position: relative;
    display: flex;
    justify-content: center;
    width: 100%;
    height: fit-content;
    overflow: hidden;
  }

  .image-frame img {
    position: relative;
    z-index: 2;
    width: auto;
    max-width: 100%;
    height: auto;
    min-height: 20rem;
    max-height: 25rem;
    object-fit: cover;
    box-shadow: 0 0 40px rgba(0, 0, 0, 0.4);
    scale: 1;

  }

  .blur-bg {
    position: absolute;
    inset: 0;
    background-position: center;

    background-size: cover;
    opacity: 0.8;

    filter: blur(20px);

    /* Blur stärker an den Seiten */
    mask-image: linear-gradient(
        to right,
        transparent 0%,
        black 20%,
        black 80%,
        transparent 100%
    );
    transform: scale(1.1);
  }
</style>
