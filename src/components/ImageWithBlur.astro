---
import { Image } from "astro:assets";

type Props = {
    src: ImageMetadata,
    alt: string,
}

const { src, alt = "" } = Astro.props;
---
<div class="image-frame">
    <div class="blur-bg" style={`background-image: url(${src.src});`}></div>
    <Image src={src} alt={alt} />
</div>

<style>
  .image-frame {
    position: relative;
    width: 100%;
    max-height: 510px;
    aspect-ratio: 16 / 8;

    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .image-frame img {
    height: 100%;
    width: auto;
    position: relative;
    z-index: 2;
    scale: 1;

    box-shadow: 0 0 40px rgba(0, 0, 0, 0.4);

  }

  .blur-bg {
    position: absolute;
    inset: 0;

    background-size: cover;
    background-position: center;

    filter: blur(20px);
    transform: scale(1.1);
    opacity: 0.8;

    /* Blur stärker an den Seiten */
    mask-image: linear-gradient(
        to right,
        transparent 0%,
        black 20%,
        black 80%,
        transparent 100%
    );
  }
</style>
