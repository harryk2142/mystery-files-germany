---
import { getCollection } from "astro:content";

// SRC: https://alvaromontoro.com/blog/67945/create-a-tag-cloud-with-html-and-css

const allPosts = await getCollection("blog");
// const tags = allPosts
//     .filter((e) => !e.data.draft)
//     .flatMap((post) => post.data.tags);
const tags = allPosts
    .map((post) => post.data.tags)
    .filter((tags): tags is string[] => !!tags)
    .flat();
const uniqueTags = [
    ...new Set(tags),
];
let tagsWithValues: Array<{
    key: string;
    value: number;
}> = [];
const maxFontSize = 4;
const minFontSize = 1;
// let maxValue = 0;
uniqueTags.forEach((key) => {
    let value = tags.filter((tag) => {
        return tag == key;
    }).length;
    value = Math.round(value / 10);
    tagsWithValues.push({
        key,
        value,
    });
});

// console.log(maxValue);

tagsWithValues = tagsWithValues
    .sort((a, b) => {
        return b.value - a.value;
    })
    .slice(0, 40);
// let maxV = 0;
