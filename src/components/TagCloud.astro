---

<style>
    ul.cloud {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        line-height: 2.5rem;
    }

    ul.cloud a[data-weight="0"] {
        --size: 0;
    }
    ul.cloud a[data-weight="1"] {
        --size: 1;
    }
    ul.cloud a[data-weight="2"] {
        --size: 2;
    }
    ul.cloud a[data-weight="3"] {
        --size: 3;
    }
    ul.cloud a[data-weight="4"] {
        --size: 4;
    }
    ul.cloud a[data-weight="5"] {
        --size: 5;
    }
    ul.cloud a[data-weight="6"] {
        --size: 6;
    }
    ul.cloud a[data-weight="7"] {
        --size: 7;
    }
    ul.cloud a[data-weight="8"] {
        --size: 8;
    }
    ul.cloud a[data-weight="9"] {
        --size: 9;
    }
    ul.cloud a[data-weight="10"] {
        --size: 10;
    }
    ul.cloud a {
        color: var(--color);
        border-color: var(--color);
        display: block;
        text-decoration: none;
        position: relative;
        padding: 5px 10px;
        margin: 10px;
        font-size: calc(var(--size) * 0.25rem + 1rem);
        border-style: solid;
        transition:
            scale 0.2s,
            transform 0.3s;
    }
    ul.cloud a:hover {
        background-color: var(--color);
        scale: 1.25;
        color: white;
    }
    ul.cloud[data-show-value] a::after {
        content: " (" attr(data-weight) ")";
        font-size: 2rem;
    }
    ul.cloud li:nth-child(1n + 1) a {
        --color: rgb(136, 96, 17);
        border-color: var(--color);
    }
    ul.cloud li:nth-child(2n + 1) a {
        --color: #181;
        border-color: var(--color);
    }
    ul.cloud li:nth-child(3n + 1) a {
        --color: #33a;
        border-color: var(--color);
    }
    ul.cloud li:nth-child(4n + 1) a {
        --color: #c38;
    }
    ul.cloud a:focus {
        outline: 1px dashed;
    }
</style>
<section id="tag-cloud">
    <ul class="cloud">
        {
            tagsWithValues.map(({ key, value }) => (
                <li class="tag">
                    <a
                        data-show-value
                        data-weight={value}
                        href={`/tags/${key}`}
                    >
                        {key}
                    </a>
                </li>
            ))
        }
    </ul>
</section>
