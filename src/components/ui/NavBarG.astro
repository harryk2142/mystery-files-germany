---
import logo from "@assets/logo.png";
import {BLOG_NAME, BLOG_SUBNAME} from "@consts";

import {Image} from "astro:assets";
import Wrapper from "./Wrapper.astro";

const {pathname} = Astro.url;
type NavigationItem = {
    href: string;
    label: string;
}
function calcIsActive(href: string, pathname: string) {
    return (href).split("/")[1] === pathname.split("/")[1];
}
const navigationItems: NavigationItem[] = [
    {href: "/", label: "Startseite"},
    {href: "/blog/1", label: "Blog"},
    {href: "/tags", label: "Tags"},
    {href: "/datenschutz", label: "Datenschutz"},
];
---
<div id="navbar-container" class="sticky primary">
    <Wrapper>
        <nav class="navbar">
            <input type="checkbox" id="menu-toggle" class="menu-toggle">
            <div>
                <a href="/" class="logo font-bold">
                    <Image src={logo} alt="Logo"/>
                </a>
            </div>
            <div class="nav-title-block">
                <a class="blog-title" href="/">
                    {BLOG_NAME}

                </a>
                <span class="blog-subline">
        {BLOG_SUBNAME}
    </span>
            </div>

            <label for="menu-toggle" class="burger-button">
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar"></span>
            </label>

            <ul class="nav-links">
                {navigationItems.map((item: NavigationItem, index: number) => {
                    const isActive = calcIsActive(item.href, pathname);
                    return (
                            <li><a class:list={[{active: isActive}]} href={item.href}>{item.label}</a></li>
                    )
                })}
            </ul>
        </nav>

    </Wrapper>
</div>
<style>
  #navbar-container {
    background-color: var(--color-primary);
    box-shadow: var(--shadow-soft);
    opacity: 0.95;
  }

  .sticky {
    position: sticky;
    top: 0;
    left: 0;
    z-index: 1000;
  }

  /* Grundstyling für die Navigation */
  .navbar {
    position: sticky;
    top: 0;
    left: 0;
    z-index: 1000; /* Sorgt dafür, dass die Navbar über dem Content liegt */
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    font-family: sans-serif;
  }

  .logo {
    display: flex;
    align-items: center;
  }

  .logo img {
    display: block;
    width: auto;
    height: 4rem;
    vertical-align: middle;
    object-fit: contain;
  }

  /* WICHTIG: Da die Navbar jetzt fixiert ist, schwebt sie über dem Inhalt.
     Füge deinem restlichen Seiteninhalt (z.B. dem <main> oder <body>)
     einen oberen Abstand hinzu, damit nichts verdeckt wird:
  body {
    padding-top: 64px;
  }
  */

  .nav-title-block {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    text-align: center;
    font-weight: bold;
  }

  .blog-title {
    font-size: var(--text-lg);
    line-height: 1.1;
  }

  .blog-subline {
    font-size: var(--text-xs);
    font-weight: 400;
    opacity: 0.8;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
    //margin-right: 20px;
    list-style: none;
  }

  .nav-links a {
    font-family: var(--font-base), sans-serif;
    color: var(--color-text);
    text-decoration: none;

    background-color: var(--color-primary);
    border-bottom: 8px solid transparent;
    border-top: 8px solid transparent;
    padding: 8px 16px;
    position: relative;
  }

  .nav-links a.active {
    border-bottom-color: var(--color-secondary);
  }

  .nav-links a:hover {
    background-color: var(--color-secondary);
    color: var(--color-primary);
  }

  ul {
    padding: 0;
    margin: 0;
    text-align: center;
    list-style: none;
  }

  /* Die Checkbox selbst wird unsichtbar gemacht */
  .menu-toggle {
    display: none;
  }

  /* Styling des Burger-Buttons */
  .burger-button {
    z-index: 1001; /* Bleibt über dem geöffneten Menü sichtbar */
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 30px;
    height: 21px;
    margin-right: 20px;
    cursor: pointer;
  }

  /* Die drei einzelnen Striche des Burgers */
  .burger-button .bar {
    width: 100%;
    height: 3px;
    background-color: var(--color-text);
    border-radius: 10px;
    transition: all 0.3s ease-in-out;
  }

  /* --- Responsive Design (Mobile Ansicht) --- */
  @media (max-width: 768px) {
    .burger-button {
      display: flex;
    }

    .nav-links {
      position: fixed;
      top: 0;
      left: 0;
      box-sizing: border-box;
      display: none;
      flex-direction: column;
      gap: 30px; /* Mehr Abstand zwischen den Links auf Mobile */
      align-items: center; /* Zentriert die Links horizontal */
      justify-content: center; /* Zentriert die Links vertikal */
      width: 100%;
      height: 100dvh; /* Nimmt die volle Bildschirmhöhe ein */
      padding: 20px;
      margin-right: 0;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      background-color: var(--color-primary);
    }

    /* Wenn die Checkbox aktiv (checked) ist, zeige das Menü an */
    .menu-toggle:checked ~ .nav-links {
      display: flex;
    }

    /* --- DIE ANIMATION ZUM X --- */
    /* Da das X jetzt innerhalb der fixierten Fullscreen-Navbar liegt,
       kannst du die Farbe hier optional ändern, falls der Hintergrund anders wäre */
    .menu-toggle:checked + .burger-button .bar {
      background-color: white;
    }

    /* Oberer Strich */
    .menu-toggle:checked + .burger-button .bar:nth-child(1) {
      transform: translateY(9px) rotate(45deg);
    }

    /* Mittlerer Strich */
    .menu-toggle:checked + .burger-button .bar:nth-child(2) {
      opacity: 0;
    }

    /* Unterer Strich */
    .menu-toggle:checked + .burger-button .bar:nth-child(3) {
      transform: translateY(-9px) rotate(-45deg);
    }
  }

  /* ÄNDERUNG 3: Verhindert das Scrollen der gesamten Webseite im Hintergrund, wenn das Menü offen ist */
  html:has(.menu-toggle:checked),
  body:has(.menu-toggle:checked) {
    overflow: hidden;
  }
</style>