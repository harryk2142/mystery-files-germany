---
import type { HTMLAttributes } from "astro/types";
type Variant = "s" | "m" | "l";
type Props = {
  variant?: Variant;
} & HTMLAttributes<"div">;
const { variant = "m", class: list, ...rest } = Astro.props;
---

<div class:list={["wrapper", variant, list]} {...rest}>
  <slot />
</div>
<style>
  @import url("Wrapper.module.css");
</style>
