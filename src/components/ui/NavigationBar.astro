---
import {BLOG_NAME, BLOG_SUBNAME} from "@consts";

import {Image} from "astro:assets";
import logo from "../../assets/logo.png";
import NavigationAnchor from "./NavigationAnchor.astro";
import Wrapper from "@ui/Wrapper.astro";
---

<div id="nav-bar" data-pagefind-ignore class="sticky">
    <Wrapper>
        <header class="content-container">
            <div class="nav-left">
                <a href="/" class="logo font-bold">
                    <Image src={logo} alt="Logo"/>
                </a>
                <div class="nav-title-block">
                    <span class="blog-title font-bold"><a href="/">
                        {BLOG_NAME}
                    </a></span>
                    <span class="blog-subline">{BLOG_SUBNAME}</span>
                </div>
                <div class="burger-container">
                    <button
                            id="burger"
                            class="burger"
                            aria-label="Menü öffnen"
                            aria-expanded="false"
                            aria-controls="menu"
                            type="button"
                    >
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>
                </div>
            </div>
            <nav id="menu" class="menu">
                <ul>
                    <li>
                        <NavigationAnchor href="/">Startseite</NavigationAnchor>
                    </li>
                    <li>
                        <NavigationAnchor href="/blog/1">Blog</NavigationAnchor>
                    </li>
                    <li>
                        <NavigationAnchor href="/tags">Tags</NavigationAnchor>
                    </li>
                    <li>
                        <NavigationAnchor href="/datenschutz">Datenschutz</NavigationAnchor>
                    </li>
                </ul>
            </nav>
        </header>
    </Wrapper>
</div>

<script>
    const button = document.getElementById("burger");
    const menu = document.getElementById("menu");
    const html = document.documentElement;
    const body = document.body;

    button?.addEventListener("click", () => {
        const isOpen = menu?.classList.toggle("open");
        button.classList.toggle("open");
        button.setAttribute("aria-expanded", String(isOpen));

        html.classList.toggle("menu-open", isOpen);
        body.classList.toggle("menu-open", isOpen);
    });
</script>

<style>
  a {
    text-decoration: none;
    cursor: pointer;
      color:var(--color-text);
  }
  a:visited{
      color: var(--color-text);
  }

  html.menu-open,
  body.menu-open {
    overflow: hidden;
  }

  #nav-bar {
    background-color: var(--color-primary);
    box-shadow: var(--shadow-soft);
    opacity: 0.9;
  }

  .sticky {
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .content-container {
    display: flex;
    justify-content: space-between;
  }

  .nav-left {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: space-between;
  }

  .nav-title-block {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    text-align: center;
  }

  .blog-title {
    font-size: var(--text-lg);
    line-height: 1.1;
  }

  .blog-subline {
    font-size: var(--text-xs);
    font-weight: 400;
    opacity: 0.8;
  }

  .logo {
    display: flex;
    align-items: center;
  }

  .logo img {
    display: block;
    width: auto;
    height: 4rem;
    vertical-align: middle;
    object-fit: contain;
  }

  .burger-container {
    /* padding-inline: 0.5rem; */
    /* padding-top:1.25rem; */
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    /* padding-inline: 0.5rem; */
    /* padding-top:1.25rem; */
    align-items: center;
    justify-content: center;
    height: 80%;
    aspect-ratio: 1;
    cursor: pointer;
    background: none;
    border: none;
  }

  .burger {
    /* margin-right: 1rem; */

    /* width: 30px; */
    position: sticky;
    height: 50%;
    /* margin-right: 1rem; */

    /* width: 30px; */
    aspect-ratio: 1;
    cursor: pointer;

    background: none;
    border: none;
  }

  .burger span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 3px;
    color: var(--color-dark);
    background: var(--color-dark);
    transition: all 0.3s ease;
  }

  .burger span:nth-child(1) {
    top: 0;
  }

  .burger span:nth-child(2) {
    top: 10px;
  }

  .burger span:nth-child(3) {
    top: 20px;
  }

  .burger.open span:nth-child(1) {
    top: 10px;
    transform: rotate(45deg);
  }

  .burger.open span:nth-child(2) {
    opacity: 0;
  }

  .burger.open span:nth-child(3) {
    top: 10px;
    transform: rotate(-45deg);
  }

  .menu {
    /* transition: opacity 0.25s ease, transform 0.25s ease; */
    position: fixed;
    inset: 0;
    display: flex;
    /* transition: opacity 0.25s ease, transform 0.25s ease; */
    align-items: center;
    justify-content: center;
    padding-right: 0;
    color: var(--color-text);
    pointer-events: none;
    background-color: var(--color-primary);

    opacity: 0;
    transform: scale(0.98);
    transition: transform 0.25s ease;
  }

  .menu.open {
    pointer-events: auto;
    opacity: 1;
    transform: scale(1);
  }

  ul {
    padding: 0;
    margin: 0;
    text-align: center;
    list-style: none;
  }

  li + li {
    margin-top: 2rem;
  }

  /* Desktop */
  @media (width >= 800px) {
    .burger {
      display: none;
    }

    .menu {
      position: static;

      display: flex;
      justify-content: flex-end;
      padding-right: 1rem;
      pointer-events: auto;
      background: none;
      opacity: 1;
      transform: none;
    }

    ul {
      display: flex;
      gap: 2rem;
    }

    li + li {
      margin-top: 0;
    }
  }
</style>
