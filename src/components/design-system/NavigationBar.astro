---
import { BLOG_NAME, BLOG_SUBNAME } from "@consts";

import { Image } from "astro:assets";
import logo from "../../assets/logo.png";
import NavigationAnchor from "./NavigationAnchor.astro";
---

<div id="nav-bar" data-pagefind-ignore class="sticky">
    <div class="wrapper">
        <header class="content-container">
            <div class="nav-left">
                <a href="/" class="logo font-bold">
                    <Image src={logo} alt="Logo"/>
                </a>
                <div class="nav-title-block">
                    <span class="blog-title font-bold">{BLOG_NAME}</span>
                    <span class="blog-subline">{BLOG_SUBNAME}</span>
                </div>
                <div class="burger-container">
                    <button
                        id="burger"
                        class="burger"
                        aria-label="Menü öffnen"
                        aria-expanded="false"
                        aria-controls="menu"
                        type="button"
                    >
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>
                </div>
            </div>
            <nav id="menu" class="menu">
                <ul>
                    <li>
                        <NavigationAnchor href="/">Startseite</NavigationAnchor>
                    </li>
                    <li>
                        <NavigationAnchor href="/blog/1">Blog</NavigationAnchor>
                    </li>
                    <li>
                        <NavigationAnchor href="/tags">Tags</NavigationAnchor>
                    </li>
                    <li>
                        <NavigationAnchor href="/datenschutz">Datenschutz</NavigationAnchor>
                    </li>
                </ul>
            </nav>
        </header>
    </div>
</div>

<script>
    const button = document.getElementById("burger");
    const menu = document.getElementById("menu");
    const html = document.documentElement;
    const body = document.body;

    button?.addEventListener("click", () => {
        const isOpen = menu?.classList.toggle("open");
        button.classList.toggle("open");
        button.setAttribute("aria-expanded", String(isOpen));

        html.classList.toggle("menu-open", isOpen);
        body.classList.toggle("menu-open", isOpen);
    });
</script>

<style>
    html.menu-open,
    body.menu-open {
        overflow: hidden;
    }

    #nav-bar {
        opacity: 0.9;
        background-color: var(--color-primary);
        box-shadow: var(--shadow-soft);
    }

    .sticky {
        position: sticky;
        top: 0;
        z-index: 1000;
    }

    .content-container {
        display: flex;
        justify-content: space-between;
    }

    .nav-left {
        align-items: center;
        display: flex;
        flex: 1;
        justify-content: space-between;
    }

    .nav-title-block {
        display: flex;
        flex: 1;
        flex-direction: column;
        justify-content: center;
        text-align: center;
    }

    .blog-title {
        font-size: var(--text-lg);
        line-height: 1.1;
    }

    .blog-subline {
        font-size: var(--text-xs);
        font-weight: 400;
        opacity: 0.8;
    }

    .logo {
        align-items: center;
        display: flex;
    }

    .logo img {
        display: block;
        height: 4rem;
        object-fit: contain;
        vertical-align: middle;
        width: auto;
    }

    .burger-container {
        /* padding-inline: 0.5rem; */
        /* padding-top:1.25rem; */
        align-items: center;
        aspect-ratio: 1;
        background: none;
        border: none;
        cursor: pointer;
        display: flex;
        height: 80%;
        justify-content: center;

        position: sticky;
        top: 0;
        z-index: 20;
    }

    .burger {
        /* margin-right: 1rem; */

        /* width: 30px; */
        aspect-ratio: 1;

        background: none;
        border: none;
        cursor: pointer;
        height: 50%;

        position: sticky;
    }

    .burger span {
        background: var(--color-dark);
        color: var(--color-dark);
        height: 3px;
        left: 0;
        position: absolute;
        transition: all 0.3s ease;
        width: 100%;
    }

    .burger span:nth-child(1) {
        top: 0;
    }

    .burger span:nth-child(2) {
        top: 10px;
    }

    .burger span:nth-child(3) {
        top: 20px;
    }

    .burger.open span:nth-child(1) {
        top: 10px;
        transform: rotate(45deg);
    }

    .burger.open span:nth-child(2) {
        opacity: 0;
    }

    .burger.open span:nth-child(3) {
        top: 10px;
        transform: rotate(-45deg);
    }

    .menu {
        /* transition: opacity 0.25s ease, transform 0.25s ease; */
        align-items: center;
        background-color: var(--color-primary);
        color: var(--color-text);
        display: flex;
        inset: 0;
        justify-content: center;

        opacity: 0;
        padding-right: 0;
        pointer-events: none;

        position: fixed;
        transform: scale(0.98);
        transition: transform 0.25s ease;
    }

    .menu.open {
        opacity: 1;
        pointer-events: auto;
        transform: scale(1);
    }

    ul {
        list-style: none;
        margin: 0;
        padding: 0;
        text-align: center;
    }

    li + li {
        margin-top: 2rem;
    }

    /* Desktop */
    @media (width >= 800px) {
        .burger {
            display: none;
        }

        .menu {
            background: none;

            display: flex;
            justify-content: flex-end;
            opacity: 1;
            padding-right: 1rem;
            pointer-events: auto;

            position: static;
            transform: none;
        }

        ul {
            display: flex;
            gap: 2rem;
        }

        li + li {
            margin-top: 0;
        }
    }
</style>
