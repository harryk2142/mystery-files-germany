---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
export type CardProps = {
    image?: {
        src: ImageMetadata;
        alt: string;
    },
}
const {image}:CardProps = Astro.props;
---
<div class="card">
    { image && (
            <div class="card-image-container">
                <Image src={image.src} alt={image.alt} format={"webp"}/>
            </div>

    )}
    <div class="card-content">
        <slot/>
    </div>

</div>
<style>
    .card {
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
        container-type: size;
        container-name: card;
        width: 100%;
        border: 2px solid var(--color-border);
        border-radius: var(--radius-border);
        background: var(--color-surface);
    }
    .card:hover {
        box-shadow: var(--box-shadow);
    }
    .card-image-container {
        display: flex;
        overflow: hidden;
        height: 100%;

        position: relative; /* Wichtig für die Positionierung des Gradients */
        //background-color: var(--color-primary);

        img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center center;
            transition: height 0.1s, transform 0.1s;

            //display: block; /* Verhindert kleine Abstände unter dem Bild */
        }

        /* Der Gradient-Layer, der in die Textbox überleitet */

        &::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 20%; /* Etwas höher für einen weicheren Übergang */

            /* Verlauf von Transparent zur Hintergrundfarbe der Textbox */
            //background: linear-gradient(
            //        to bottom,
            //        transparent 0%,
            //        var(--color-primary) 100%
            //);

            pointer-events: none;
        }
    }
    .card-content{
        width: 100%;

        padding: 8px 16px;
    }
</style>