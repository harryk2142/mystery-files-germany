---
import "./Card.css";

import ImageWithBlur from "@components/ImageWithBlur.astro";
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";

import { Image } from "astro:assets";
export type CardProps = {
    image?: {
        src: ImageMetadata; alt: string;
    }
}
type Props = CardProps & HTMLAttributes<"div">;
const {image, class: list, ...rest} = Astro.props;
---
<div class:list={["card", list]} {...rest}>
    {image && (
            <div class="card-image-container">
                <ImageWithBlur alt={image.alt} src={image.src} />
            </div>
    )}
    <div class="card-content">
        <slot/>
    </div>
</div>