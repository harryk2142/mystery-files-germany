    .card-image-container {
        display: flex;
        overflow: hidden;
        height: 100%;

        position: relative; /* Wichtig für die Positionierung des Gradients */
        //background-color: var(--color-primary);

        img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center center;
            transition: height 0.1s, transform 0.1s;

            //display: block; /* Verhindert kleine Abstände unter dem Bild */
        }

        /* Der Gradient-Layer, der in die Textbox überleitet */
        &::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 20%; /* Etwas höher für einen weicheren Übergang */

            /* Verlauf von Transparent zur Hintergrundfarbe der Textbox */
            //background: linear-gradient(
            //        to bottom,
            //        transparent 0%,
            //        var(--color-primary) 100%
            //);

            pointer-events: none;
        }
    }
    .card-content{
        //position: absolute;
        //bottom: 0;
        //color: white;
        //overflow: hidden;
        //border-bottom-left-radius: 16px;
        //border-bottom-right-radius: 16px;
        width: 100%;

        padding: 8px 16px;

        //background-color: var(--color-primary);
        //color: var(--color-secondary);

        .card-date {
            display: block;
            font-size: 1rem;
            font-weight: bold;
        }

        .card-summary {

            display: block;

            //margin-top: 0.5rem;
            font-size: 1.5rem;
            //font-weight: 700;
            text-wrap: pretty;
            overflow: hidden;
            display: -webkit-box;
            -webkit-box-orient: vertical;
        }
    }













