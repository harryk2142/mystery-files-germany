---
import Card, { type CardProps } from "@components/design-system/Card.astro";
type Props = {
    pubDate: Date; title: string; url: string;
} & CardProps;
const {pubDate, image, title, url} = Astro.props;
---
<a href={url}>
    <Card class="blogpost-card" image={image}>
        <div class="blogpost-content">
            <span class="date">
                <time data-pagefind-sort="date" datetime={pubDate.toISOString()}>
                    {pubDate.toLocaleDateString("de-DE", {
                        year: "numeric", month: "short", day: "numeric",
                    })}
                </time>
            </span>
            <span class="summary">{title}</span>
        </div>
    </Card>
</a>
<style>
    a {
        text-decoration: none;
        color: var(--color-text);
    }

    .blogpost-card {
        container-name: card;
        container-type: size;
    }

    .blogpost-card:hover {
        box-shadow: var(--box-shadow);
    }

    .date {
        padding: 8px 16px;
        display: block;
        font-size: 1rem;
        font-weight: bold;
    }

    .summary {
        padding: 8px 16px;
        display: block;
        font-size: 1.5rem;
        text-wrap: pretty;
        overflow: hidden;
        display: -webkit-box;
        -webkit-box-orient: vertical;
    }

    @container card (max-height: 40rem) {
        .summary {
            -webkit-line-clamp: 3;
        }
    }

    @container card (max-height: 20rem) {
        .summary {
            -webkit-line-clamp: 1;
        }
    }

</style>
