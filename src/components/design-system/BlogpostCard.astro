<a href={url}>
    <div class="card">
        <div class="card-image-container">
            <img src={thumbnail} alt={thumbnailAlt} class="card-image" />
        </div>
        <div class="card-content">
            <span class="card-date">
                <time data-pagefind-sort="date" datetime={pubDate.toISOString()}>
                    {pubDate.toLocaleDateString("de-DE", {
                        year: "numeric",
                        month: "short",
                        day: "numeric",
                    })}
                </time>
            </span>
            <span class="card-summary">{title}</span>
        </div>
    </div>
</a>
