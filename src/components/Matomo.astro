---

const isDev = import.meta.env.DEV;
const { host:hostFromUrl } = Astro.url;
const isProd = hostFromUrl === Astro.site?.host;
---
<!-- Matomo -->
{(!isDev && isProd)&& (
<>
    <script is:inline>
        let _paq = window._paq = window._paq || [];
        /* tracker methods like "setCustomDimension" should be called before "trackPageView" */
        _paq.push(["disableCookies"]);
        _paq.push(["enableHeartBeatTimer", 5]);
        _paq.push(["trackPageView"]);
        _paq.push(["enableLinkTracking"]);
        const embedTrackingCode = () => {
            var u="https://harry-kramer.net/matomo/";
            _paq.push(["setTrackerUrl", u + "matomo.php"]);
            _paq.push(["setSiteId", "1"]);
            let d = document, g = d.createElement("script"), s = d.getElementsByTagName("script")[0];
            g.async = true;
            g.src = u + "matomo.js";
            s.parentNode.insertBefore(g, s);
        };
        setTimeout(() => {
            embedTrackingCode();
        }, 5);
    </script>
    <noscript>
        <!-- Matomo Image Tracker-->
        <img referrerpolicy="no-referrer-when-downgrade" src="https://harry-kramer.net/matomo/matomo.php?idsite=1&amp;rec=1" style="border:0" alt="" />
        <!-- End Matomo -->
    </noscript>
</>)
    }
<!-- End Matomo Code -->
