---
export type Props = {
    url: {
        current: string;
        prev: string | undefined;
        next: string | undefined;
    };
    urlToFirst: string;
    urlToLast: string;
    currentPage: number;
    lastPage: number;
};
const { urlToFirst, urlToLast, currentPage, lastPage, url } = Astro.props;

const showFirst = currentPage > 2;
const showLast = currentPage + 2 <= lastPage;
---

<nav class="pagination">
    {
        showFirst ? (
            <a href={urlToFirst}>
                &#60;&#60;
            </a>
        ) : null
    }
    {showFirst ? <div class="dots">&bull;&bull;&bull;</div> : null}
    {
        url.prev ? (
            <a class="previous" href={url.prev}>
                &#60;
            </a>
        ) : null
    }
    {currentPage - 1 > 0 ? <a href={url.prev}>{currentPage - 1}</a> : null}
    <a class="active" href={url.current}>{currentPage}</a>
    {currentPage < lastPage ? <a href={url.next}>{currentPage + 1}</a> : null}
    {
        url.next ? (
            <a href={url.next}>
                &#62;
            </a>
        ) : null
    }
    {showLast ? <div class="dots">&bull;&bull;&bull;</div> : null}
    {
        showLast ? (
            <a href={urlToLast}>
                &#62;&#62;
            </a>
        ) : null
    }
</nav>

<style>
    .pagination {
        display: flex;
        flex-direction: row;
        height: 3rem;

        a {
            display: flex;

            font-size: 1.5rem;
            align-items: center;
            justify-content: center;
            border: 2px solid var(--color-black);
            color: var(--color-text);
            text-decoration: none;
            border-radius: 5px;
            aspect-ratio: 1;
        }

        a:hover {
            background-color: var(--color-link);
        }

        a.active {
            color: var(--color-white);
            background-color: var(--color-black);
        }

        .dots {
            font-size: 2rem;
            font-weight: bold;
        }

        .dots::before,
        .dots::after {
            content: " ";
            white-space: pre;
        }
    }

    @media (width < 900px) {
        .dots {
            display: none;
        }
    }
</style>
