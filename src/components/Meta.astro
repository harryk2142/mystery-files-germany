---
import { BLOG_NAME } from "@consts";
export type Props = {
    title: string;
    description: string;
    creator?: string;
    keywords?: string[];
    icon?: string;
    themeColor?: string;
    colorScheme?: ColorScheme;
    twitter?: MetaTwitter
    openGraph?: MetaOg;
    robots?: string;
    image?: {
        src: string;
        // type: string;
        // width: string;
        // height: string;
        alt: string;
    };
};
type ColorScheme = "normal" | "light" | "dark" | "only light";
type OpenGraphObjectType =
    | "music.song"
    | "music.album"
    | "music.playlist"
    | "music.radio_station"
    | "video.movie"
    | "video.episode"
    | "video.tv_show"
    | "video.other"
    | "article"
    | "book"
    | "profile"
    | "website";
type TwitterCardType = "summary" | "summary_large_image" | "app" | "player";
export type MetaTwitter = {
    card: TwitterCardType;
    creator: string;
    image:{
        src: string;
        alt: string;
    }
}
export type MetaOg = {
    type: OpenGraphObjectType;
    publishedTime: string;
    modifiedTime?: string;
    expirationTime?: string;
    tag?: string;
    section?: string;
    image:{
        src: string;
        alt: string;
    }
}

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const {
    title,
    description,
    creator = "Harry Kramer",
    keywords = [],
    themeColor = "light",
    colorScheme = "light",
    twitter = {
        card: "summary_large_image",
        image : {
            src: "/logo.png",
            alt: "Logo der Website"
        }
    },
    robots = "",
    openGraph = {
        type: "website",
        publishedTime: Date.now().toLocaleString(),
        image : {
            src: "/logo.png",
            alt: "Logo der Website"
        }
    }
} = Astro.props;
---

<Fragment>
    <!-- Global Metadata -->
    <meta charset="utf-8" />
    <meta content="width=device-width,initial-scale=1" name="viewport" />
    <meta content={Astro.generator} name="generator" />

    <!--Sitemap-->
    <link rel="sitemap" href="/sitemap-index.xml"/>

    <!--RSS-->
    <link
        rel="alternate"
        type="application/rss+xml"
        title={title}
        href={new URL('rss.xml', Astro.site)}
    />

    <!-- Icons -->
    <link rel="icon" href="/favicon.ico" />
    <link href="/logo.png" rel="icon" type="image/png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/logo-32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/logo-16.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/logo-192.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/logo-512.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/logo-180.png">
    <link rel="manifest" href="/manifest.json">

    <!-- Canonical URL -->
    <link href={canonicalUrl} rel="canonical" />

    <!-- Primary Meta Tags -->
    <meta content={title} name="title" />
    <meta content={description} name="description" />

    <!--<meta content={keywords.join(", ")} name="keywords" />-->

    <meta content={colorScheme} name="color-scheme" />
    <meta content={themeColor} name="theme-color" />
    <!-- <meta content={robots} name="robots" />-->

    <!--open graph/facebook-->
    <meta content={BLOG_NAME} property="og:site_name" />
    <meta content={canonicalUrl} property="og:url" />
    <meta content={openGraph.type} property="og:type" />
    <meta content={title} property="og:title" />
    <meta content="de_DE" property="og:locale" />
    <meta content={description} property="og:description"/>
    <meta content={new URL(openGraph.image.src, Astro.url)} property="og:image" />
    {
        openGraph.type === "article" && (
            <meta content={openGraph.publishedTime} name="article:published_time" property="og:type" />
        )
    }
    <meta content={creator} name="article:author" property="og:type" />

    <!--twitter-->
    <meta content={creator} name="twitter:creator" />
    <meta content="the-ai-files.de" name="twitter:domain" />
    <meta content={twitter.card} name="twitter:card" />
    <meta content={canonicalUrl} name="twitter:url" />
    <meta content={title} name="twitter:title" />
    <meta content={description} name="twitter:description" />
    <meta content={new URL(twitter.image.src, Astro.url)} name="twitter:image" />
    <meta content={twitter.image.alt} name="twitter:image:alt" />
</Fragment>
