---
import "@styles/reset.css";
import "@styles/global.css";

import NavigationBar from "@components/design-system/NavigationBar.astro";
import Matomo from "@components/Matomo.astro";
import Meta from "@components/Meta.astro";
import DesignSystemSetup from "@design-system/DesignSystemSetup.astro";

type Props = {
  title: string;
  description: string;
  pagefindIgnore?: boolean;
  current?: string;
};
const { title, description, pagefindIgnore = true } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <title>{title}</title>
    <Meta description={description} title={title} />
    <Matomo />
    <DesignSystemSetup />
  </head>
  <body data-pagefind-ignore={pagefindIgnore}>
    <NavigationBar />

    <slot />
  </body>
</html>
