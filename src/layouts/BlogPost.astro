---
import Footer from "@components/Footer.astro";
import ImageWithBlur from "@components/ImageWithBlur.astro";
import Matomo from "@components/Matomo.astro";
import Meta from "@components/Meta.astro";
import {ActionBar} from "@features/action-bar/ActionBar";
import {CommentsContainer} from "@features/comments/CommentsContainer";
import DesignSystem from "@ui/DesignSystem.astro";
import NavigationBar from "@ui/NavigationBar.astro";
import Wrapper from "@ui/Wrapper.astro";
import {type GeneratedImagePaths, getGeneratedImagePaths} from "@utils/getImagePaths";

import type {CollectionEntry} from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import {Image} from "astro:assets";

type Props = CollectionEntry<"blog">["data"];

const {slug} = Astro.params;
const {title, description, pubDate, headline, updatedDate, heroImage, place} = Astro.props;

let imagePaths: GeneratedImagePaths = {
    search: "", og: "", originalName: "", twitter: ""
};

if (heroImage.src) {
    imagePaths = getGeneratedImagePaths(heroImage.src);
}
---

<html lang="de">
    <head>
        <title>{title}</title>
        <Meta
                description={description}
                title={title}
                openGraph={{
                    type: "article",
                    publishedTime: pubDate.toISOString(),
                    image: {alt: heroImage.alt, src: imagePaths.og},
                }}
                twitter={{
                    card: "summary_large_image", creator: "Harry Kramer", image: {
                        alt: heroImage.alt, src: imagePaths.twitter
                    },
                }}/>
        <Matomo/>
        <DesignSystem/>
        <style>
          main {
            max-width: 100%;
          }

          .blogpost {
            display: flex;
            flex-direction: column;
            overflow: hidden;
          }

          .hero-image-container {
            display: flex;
            justify-content: center;
            padding-top: 2rem;

            .hero-image {
              border-radius: 12px;
              height: 32rem;
              box-shadow: var(--shadow-box);
              width: auto;
            }
          }

          .prose {
            padding-top: 2rem;
            color: var(--color-text);
          }

          .title {
            padding: 0.5rem 0;
            margin-bottom: 1rem;
            line-height: 1;
            text-align: center;
          }

          .title h1 {
            margin-block: 0.75rem;
          }

          .date {
            color: var(--color-text);
            font-family: var(--font-lato), sans-serif;
            font-size: 1.2rem;
          }

          .last-updated-on {
            font-style: italic;
          }

          .post-content {
            font-size: 1.2rem;
            line-height: 2;
            text-align: justify;
          }
        </style>
    </head>

    <body>
        <NavigationBar/>
        <main data-pagefind-body>
            <article class="blogpost">
                {heroImage.src && (
                        <Wrapper variant="s">
                            <div class="hero-image-container">
                                <!--<Image-->
                                <!--        alt={headline}-->
                                <!--        data-pagefind-meta="image[src], image_alt[alt]"-->
                                <!--        fit="cover"-->
                                <!--        height={300}-->
                                <!--        quality={70}-->
                                <!--        src={imagePaths.search}-->
                                <!--        width={300}-->
                                <!--/>-->
                                <img
                                        alt={heroImage.alt}
                                        data-pagefind-index-attrs="alt"
                                        data-pagefind-meta="image[src], image_alt[alt]"
                                        hidden
                                        src={imagePaths.search}
                                        style="display: none;"
                                />
                                <Image class={"hero-image"} src={heroImage.src} alt={heroImage.alt} format="webp"/>
                            </div>

                        </Wrapper>
                )}
                <Wrapper variant="s">
                    <div class="prose">
                        <div class="title">
                            <div class="date">
                                <FormattedDate date={pubDate}/>
                                {updatedDate && (
                                        <div class="last-updated-on">
                                            Last updated on
                                            <FormattedDate date={updatedDate}/>
                                        </div>)}
                            </div>
                            <h1 data-pagefind-meta="title">{title}</h1>
                            <div class="box">
                                <span>{place}</span>
                            </div>
                            <hr/>
                        </div>
                        <div class="post-content">
                            <slot/>
                        </div>
                    </div>
                </Wrapper>
            </article>
            <ActionBar client:load headline={headline} title={title} slug={slug || ""}/>
            <section id="comments-section">
                <Wrapper variant="s">
                    {slug && (
                            <CommentsContainer slug={slug as string} client:idle/>)}
                </Wrapper>
            </section>
        </main>

        <Footer/>
    </body>
</html>
