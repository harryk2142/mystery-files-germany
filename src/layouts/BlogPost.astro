---
import DesignSystemSetup from "@design-system/DesignSystemSetup.astro";

import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import { ActionBar } from "@features/action-bar/ActionBar";
import { CommentsContainer } from "@features/comments/CommentsContainer";
import Wrapper from "@components/design-system/Wrapper.astro";

type Props = CollectionEntry<"blog">["data"];

const { slug } = Astro.params;
const { title, description, pubDate,headline, updatedDate, heroImage } = Astro.props;
---

<html lang="de">
  <head>
    <title>{title}</title>
    <DesignSystemSetup />
    <BaseHead title={title} description={description} />
    <style>
      main {
        margin: 0;
        max-width: 100%;
        width: calc(100% - 2em);
      }

      .hero-image {
        width: 100%;
      }

      .hero-image img {
        border-radius: 12px;
        box-shadow: var(--box-shadow);
        display: block;
        margin: 0 auto;
      }

      .prose {
        color: rgb(var(--gray-dark));
        margin: auto;
        max-width: calc(100% - 2em);
        padding: 1em;
        width: 720px;
      }

      .title {
        line-height: 1;
        margin-bottom: 1em;
        padding: 1em 0;
        text-align: center;
      }

      .title h1 {
        margin: 0 0 0.5em;
      }

      .date {
        color: rgb(var(--gray));
        margin-bottom: 0.5em;
      }

      .last-updated-on {
        font-style: italic;
      }
    </style>
  </head>

  <body>
    <Header />
    <main>
      <article>
        <div class="hero-image">
          {
            heroImage.src && (
              <Image alt="" height={510} src={heroImage.src} width={1020} />
            )
          }
        </div>
        <div class="prose">
          <div class="title">
            <div class="date">
              <FormattedDate date={pubDate} />
              {
                updatedDate && (
                  <div class="last-updated-on">
                    Last updated on
                    <FormattedDate date={updatedDate} />
                  </div>
                )
              }
            </div>
            <h1>{title}</h1>
            <hr />
          </div>
          <slot />
        </div>
      </article>
        <ActionBar client:load headline={headline} title={title} slug={slug || ""}} />

        {slug && (
            <div>
                <section id="comments-section">
                    <Wrapper variant="s">
                        <CommentsContainer slug={slug as string} client:visible/>
                    </Wrapper>
                </section>
            </div>
        )}
    </main>
  </body>
</html>
