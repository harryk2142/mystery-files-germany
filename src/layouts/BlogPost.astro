---
import Footer from "@components/Footer.astro";
import Matomo from "@components/Matomo.astro";
import Meta from "@components/Meta.astro";
import { ActionBar } from "@features/action-bar/ActionBar";
import { CommentsContainer } from "@features/comments/CommentsContainer";
import DesignSystem from "@ui/DesignSystem.astro";
import Wrapper from "@ui/Wrapper.astro";
import { type GeneratedImagePaths, getGeneratedImagePaths } from "@utils/getImagePaths";

import type { CollectionEntry } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import { Image } from "astro:assets";
import NavBarG from "@ui/NavBarG.astro";

type Props = CollectionEntry<"blog">["data"];

const {slug} = Astro.params;
const {title, description, pubDate, headline, updatedDate, heroImage, place} = Astro.props;

let imagePaths: GeneratedImagePaths = {
    search: "", og: "", originalName: "", twitter: ""
};

if (heroImage.src) {
    imagePaths = getGeneratedImagePaths(heroImage.src);
}
---

<html lang="de">
    <head>
        <title>{title}</title>
        <Meta
                description={description}
                title={title}
                openGraph={{
                    type: "article",
                    publishedTime: pubDate.toISOString(),
                    image: {alt: heroImage.alt, src: imagePaths.og},
                }}
                twitter={{
                    card: "summary_large_image", creator: "Harry Kramer", image: {
                        alt: heroImage.alt, src: imagePaths.twitter
                    },
                }}/>
        <Matomo/>
        <DesignSystem/>
        <style>
            main {
                max-width: 100%;
            }

            .blogpost {
                display: flex;
                flex-direction: column;
                align-items: center;
            }

            .hero-image-container {
                display: flex;
                justify-content: center;
                margin-top: 2rem;
                overflow: hidden;
                border-radius: var(--radius-border);
                box-shadow: var(--shadow-box);
                max-width: calc(100% - 2rem);

                .hero-image {
                    //border-radius: 12px;
                    display: block;
                    max-height: 25rem;
                    min-height: 20rem;
                    height: auto;
                    width: auto;
                    object-fit: cover;
                    max-width: 100%;

                }
            }

            .prose {
                padding-top: 2rem;
                color: var(--color-text);
            }

            .title {
                padding: 0.5rem 0;
                margin-bottom: 1rem;
                line-height: 1;
                text-align: center;
            }

            .title h1, h2{
                margin-block: 1rem;
            }

            .date {
                color: var(--color-text);
                font-family: var(--font-lato), sans-serif;
                font-size: 1.2rem;
            }

            .last-updated-on {
                font-style: italic;
            }

            .place {
                padding: 16px;
            }

            .post-content {
                font-size: 1.2rem;
                line-height: 2;
                text-align: justify;
                > h2 {
                    margin: 2rem 0 1rem;
                }
            }
        </style>
    </head>

    <body>
        <NavBarG/>
        <main data-pagefind-body>

            <Wrapper variant="s">
                <article class="blogpost">
                    {heroImage.src && (<img
                                    alt={heroImage.alt}
                                    data-pagefind-index-attrs="alt"
                                    data-pagefind-meta="image[src], image_alt[alt]"
                                    hidden
                                    src={imagePaths.search}
                                    style="display: none;"
                            />
                            <div class="hero-image-container">
                                <!--<Image-->
                                <!--        alt={headline}-->
                                <!--        data-pagefind-meta="image[src], image_alt[alt]"-->
                                <!--        fit="cover"-->
                                <!--        height={300}-->
                                <!--        quality={70}-->
                                <!--        src={imagePaths.search}-->
                                <!--        width={300}-->
                                <!--/>-->

                                <Image class={"hero-image"} src={heroImage.src} alt={heroImage.alt} format="webp"/>
                            </div>


                    )}
                    <div class="box prose">
                        <div class="title">
                            <div class="date">
                                <FormattedDate date={pubDate}/>
                                {updatedDate && (
                                        <div class="last-updated-on">
                                            Last updated on
                                            <FormattedDate date={updatedDate}/>
                                        </div>)}
                            </div>
                            <h1 data-pagefind-meta="title">{title}</h1>
                            <div class="box place">
                                <span>{place}</span>
                            </div>
                            <hr/>
                        </div>
                        <div class="post-content">
                            <slot/>
                        </div>
                    </div>
                </article>
                <ActionBar client:load headline={headline} title={title} slug={slug || ""}/>
                <section id="comments-section">
                    {slug && (
                            <CommentsContainer slug={slug as string} client:idle/>)}
                </section>
            </Wrapper>
        </main>

        <Footer/>
    </body>
</html>
