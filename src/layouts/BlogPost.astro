---
import NavigationBar from "@ui/NavigationBar.astro";
import Wrapper from "@ui/Wrapper.astro";
import Footer from "@components/Footer.astro";
import ImageWithBlur from "@components/ImageWithBlur.astro";
import Matomo from "@components/Matomo.astro";
import Meta from "@components/Meta.astro";
import { ActionBar } from "@features/action-bar/ActionBar";
import { CommentsContainer } from "@features/comments/CommentsContainer";

import type { CollectionEntry } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import DesignSystem from "@ui/DesignSystem.astro";
import { type GeneratedImagePaths, getGeneratedImagePaths } from "@utils/getImagePaths";

type Props = CollectionEntry<"blog">["data"];

const {slug} = Astro.params;
const {title, description, pubDate, headline, updatedDate, heroImage, place} = Astro.props;

let imagePaths: GeneratedImagePaths = {
    search: "", og: "", originalName: "", twitter: ""
};

if (heroImage.src) {
    imagePaths = getGeneratedImagePaths(heroImage.src);
}
console.log(imagePaths);
---

<html lang="de">
    <head>
        <title>{title}</title>
        <Meta
                description={description}
                title={title}
                openGraph={{
                    type: "article",
                    publishedTime: pubDate.toISOString(),
                    image: {alt: heroImage.alt, src: imagePaths.og},
                }}
                twitter={{
                    card: "summary_large_image", creator: "Harry Kramer", image: {
                        alt: heroImage.alt, src: imagePaths.twitter
                    },
                }}/>
        <Matomo/>
        <DesignSystem/>
        <style>
            main {
                max-width: 100%;
            }

            .hero-image {
                width: 100%;
            }

            .hero-image img {
                display: block;
                margin: 0 auto;
                border-radius: 12px;
                box-shadow: var(--box-shadow);
            }

            .prose {
                width: 720px;
                max-width: calc(100% - 2em);
                padding: 1em;
                margin: auto;
                color: var(--color-text);
            }

            .title {
                padding: 1em 0;
                margin-bottom: 1em;
                line-height: 1;
                text-align: center;
            }

            .title h1 {
                margin: 0 0 0.5em;
            }

            .date {
                margin-bottom: 0.5em;
                color: rgb(var(--gray));
            }

            .last-updated-on {
                font-style: italic;
            }

            .post-content {
                font-size: 1.2rem;
                line-height: 2;
                text-align: justify;
            }
        </style>
    </head>

    <body>
        <NavigationBar/>
        <main data-pagefind-body>
            <article>
                <div>
                    {heroImage.src && (
                            <div>
                                <!--<Image-->
                                <!--        style="display: none"-->
                                <!--        src={imagePaths.search}-->
                                <!--        alt={headline}-->
                                <!--        width={300}-->
                                <!--        height={300}-->
                                <!--        quality={70}-->
                                <!--        fit={"cover"}-->
                                <!--        data-pagefind-meta="image[src], image_alt[alt]"-->
                                <!--/>-->
                                <img
                                        alt={heroImage.alt}
                                        data-pagefind-index-attrs="alt"
                                        data-pagefind-meta="image[src], image_alt[alt]"
                                        hidden
                                        src={imagePaths.search}
                                        style="display: none;"
                                />
                                <ImageWithBlur alt={heroImage.alt} src={heroImage.src}/>

                            </div>

                    )}
                </div>
                <div class="prose">
                    <div class="title">
                        <div class="date">
                            <FormattedDate date={pubDate}/>
                            {updatedDate && (
                                    <div class="last-updated-on">
                                        Last updated on
                                        <FormattedDate date={updatedDate}/>
                                    </div>)}
                        </div>
                        <h1 data-pagefind-meta="title">{title}</h1>
                        <div class="box">
                            <span>{place}</span>
                        </div>
                        <hr/>
                    </div>
                    <div class="post-content">
                        <slot/>
                    </div>
                </div>
            </article>
            <ActionBar client:load headline={headline} title={title} slug={slug || ""}/>
            <section id="comments-section">
                <Wrapper variant="s">
                    {slug && (
                            <CommentsContainer slug={slug as string} client:idle/>)}
                </Wrapper>
            </section>
        </main>

        <Footer/>
    </body>
</html>
