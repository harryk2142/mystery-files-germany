---
import Meta from "@components/Meta.astro";
import NoIndexLayout from "@layouts/NoIndexLayout.astro";
import Wrapper from "@ui/Wrapper.astro";
import PageTitle from "@ui/PageTitle.astro";
interface Props {
    error: unknown;
}

const { error } = Astro.props;
---
<NoIndexLayout title="Fehlerseite" description="Fehlerseite">
    <main>
        <Wrapper>
            <PageTitle title="Fehlerseite"/>
            {error instanceof Error ? error.message : "Unknown error"}
        </Wrapper>
    </main>
</NoIndexLayout>
