---
import BlogpostCard from "@ui/BlogpostCard.astro";
import Pagefind from "@ui/Pagefind.astro";
import Wrapper from "@ui/Wrapper.astro";
import { BLOG_NAME, SITE_DESCRIPTION_SHORT } from "@consts";
import BreakingNews from "@features/breaking-news/BreakingNews.astro";
import MainLayout from "@layouts/MainLayout.astro";

import {
    getCollection, type InferEntrySchema, type RenderedContent
} from "astro:content";
import Ufo, { Sizes } from "@ui/Ufo.astro";

const shuffle = (array: {
    id: string;
    body?: string;
    collection: "blog";
    data: InferEntrySchema<"blog">;
    rendered?: RenderedContent;
    filePath?: string;
}[]) => {
    return array
        .map((entry) => ({sort: Math.random(), value: entry}))
        .sort((a, b) => a.sort - b.sort)
        .map((entry) => entry.value);
};
const collection = await getCollection("blog");
const posts = collection.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 12);
---

<MainLayout
        title={"Startseite von " + BLOG_NAME}
        description={SITE_DESCRIPTION_SHORT}
>
    <main data-pagefind-ignore>
        <Wrapper variant="m">
            <BreakingNews/>
        </Wrapper>

        <Wrapper variant="s">
            <section id="area-title" class="text-center">
                <span>Welcome to</span>
                <h1>{BLOG_NAME}</h1>
            </section>
        </Wrapper>
        <Wrapper variant="m">
            <Pagefind/>
        </Wrapper>
        <Wrapper>
            <div id="container-main" class="box">
                <div class="grid-blogposts">
                    {posts.map((post, index) => {
                        let cardClass = "card-small";
                        if (index === 0) cardClass = "card-featured"; else if (index % 8 === 0) cardClass = "card-big"; else if (index % 3 === 0) cardClass = "card-portrait";
                        // else if (index % 3 === 0) cardClass = "card-landscape";

                        return (
                                <article class={`${cardClass}`}>
                                    {post.data.heroImage.src && (
                                            <BlogpostCard
                                                    pubDate={post.data.pubDate}
                                                    image={{
                                                        src: post.data.heroImage.src, alt: post.data.heroImage.alt,
                                                    }}
                                                    title={post.data.title}
                                                    url={"/blog/" + post.id}
                                            />)}
                                </article>);
                    })}
                </div>
                <section class="box center" id="area-load-more-blogposts">
                    <a class="button" href={"/blog/2"}>
                        <span style="font-size: 1.5rem;">Mehr</span>
                        <Ufo size={Sizes.M}/>
                    </a>
                </section>
            </div>
        </Wrapper>
    </main>
</MainLayout>
<style>
    main{
        gap: 16px;
        display: flex;
        flex-direction: column;
    }
    #area-load-more-blogposts {
        grid-area: moreBlogposts;
        display: flex;
        align-items: center;

        a {
            width: 100%;
        }
    }

    .grid-container {
        display: flex;
        flex-direction: column;
        container-name: grid-container;
        container-type: inline-size;
    }

    #container-main {
        display: flex;
        flex-direction: column;
        width: 100%;
        container-name: container-main;
        container-type: inline-size;
    }

    #grid-container {
        * > * {
            height: 20rem;
        }
    }

    #area-title {
        h1 {
            /*font-size: clamp(1.25rem, 3vw, 1.5rem);line-height: 1;*/
        }
    }

    #section-latest-blogpost {
        position: relative;
    }

    /* --- Desktop --- */
    @container container-main (min-width: 900px) {
        .grid-blogposts {
            display: grid;
            grid-template-columns: repeat(8, 1fr);
            grid-auto-rows: minmax(6rem, auto);
            grid-auto-flow: dense; /* SEHR WICHTIG: Füllt Löcher automatisch auf! */
            gap: 16px;
        }

        .card-featured {
            grid-row: span 4;
            grid-column: span 8;
        }

        .card-big {
            grid-row: span 4;
            grid-column: span 4;
        }

        .card-landscape {
            grid-row: span 2;
            grid-column: span 4;
        }

        .card-portrait {
            grid-row: span 4;
            grid-column: span 2;
        }

        .card-small {
            grid-row: span 4;
            grid-column: span 2;
        }
    }

    /* --- Tablet --- */
    @container container-main (650px < width) and (width < 900px) {
        .grid-blogposts {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            grid-auto-rows: minmax(240px, auto);
            grid-auto-flow: dense; /* SEHR WICHTIG: Füllt Löcher automatisch auf! */
            gap: 16px;
        }

        .card-featured {
            grid-row: span 2;
            grid-column: span 4;
        }

        .card-big {
            grid-row: span 2;
            grid-column: span 2;
        }

        .card-landscape {
            grid-row: span 2;
            grid-column: span 2;
        }

        .card-portrait {
            grid-row: span 2;
            grid-column: span 2;
        }

        .card-small {
            grid-row: span 2;
            grid-column: span 2;
        }
    }

    /* --- Mobile --- */
    @container container-main (width <= 650px) {
        .grid-blogposts {
            display: flex;
            flex-direction: column;
            gap: 20px;

            .card {
                height: 28rem;
            }
        }
    }
</style>
