---
import { getCollection } from "astro:content";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Meta from "../../components/Meta.astro";

const isNotUndefined = (items: string[] | undefined): items is string[] => {
    return !!items;
};
export async function getStaticPaths() {
    const allPosts = (await getCollection("blog")).filter((e) => !e.data.draft).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    const tags = allPosts
        .map((post) => post.data.tags)
        .filter((tags): tags is string[] => !!tags)
        .flat();

    const uniqueTags: string[] = [
        ...new Set<string>(tags),
    ];

    return uniqueTags.map((tag) => {
        const filteredPosts = allPosts.filter((post) => post.data.tags?.includes(tag));

        return {
            params: {
                tag,
            },
            props: {
                posts: filteredPosts,
            },
        };
    });
}

const { tag } = Astro.params;
const { posts } = Astro.props;
import Matomo from "../../components/Matomo.astro";
import NavigationBar from "@ui/NavigationBar.astro";
import DesignSystemSetup from "@design-system/DesignSystemSetup.astro";
import PageTitle from "@ui/PageTitle.astro";
import NoIndexLayout from "@layouts/NoIndexLayout.astro";
import Wrapper from "@ui/Wrapper.astro";
---
<NoIndexLayout title={"Hashtag"+tag} description={"Beiträge zum Hashtag " + tag}>
    <main>
        <Wrapper variant="s">
            <div id="tag-container">
                <PageTitle title={"#"+ tag}/>
                <div id="tag-list">
                    <ul id="list-of-blogposts">
                        {
                            posts.map((post) => (
                                    <li class="shadow border-radius">
                                        <a
                                                class="link-to-blogpost link"
                                                href={`/blog/${post.id}`}
                                        >
                                        <span class="date-for-blogpost">
                                            <FormattedDate
                                                    date={post.data.pubDate}
                                            />
                                        </span>
                                            <span class="title-for-blogpost">
                                            {post.data.title}
                                        </span>
                                        </a>
                                    </li>
                            ))
                        }
                    </ul>
                </div>
            </div>
        </Wrapper>

    </main>
</NoIndexLayout>
