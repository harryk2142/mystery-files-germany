---
import { getCollection } from "astro:content";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Meta from "../../components/Meta.astro";

const isNotUndefined = (items: string[] | undefined): items is string[] => {
    return !!items;
};
export async function getStaticPaths() {
    const allPosts = (await getCollection("blog")).filter((e) => !e.data.draft).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    const tags = allPosts
        .map((post) => post.data.tags)
        .filter((tags): tags is string[] => !!tags)
        .flat();

    const uniqueTags: string[] = [
        ...new Set<string>(tags),
    ];

    return uniqueTags.map((tag) => {
        const filteredPosts = allPosts.filter((post) => post.data.tags?.includes(tag));

        return {
            params: {
                tag,
            },
            props: {
                posts: filteredPosts,
            },
        };
    });
}

const { tag } = Astro.params;
const { posts } = Astro.props;
import Matomo from "../../components/Matomo.astro";
import NavigationBar from "@components/design-system/NavigationBar.astro";
import DesignSystemSetup from "@design-system/DesignSystemSetup.astro";
import PageTitle from "@components/design-system/PageTitle.astro";
---

<html lang="de">
    <head>
        <title>Hashtag {tag}</title>
        <Meta description={"Beiträge zum Hashtag " + tag} title={"Beiträge zum Hashtag " + tag} />
        <meta content="noindex" name="robots" />
        <Matomo />
        <DesignSystemSetup/>
    </head>
    <body data-pagefind-ignore>
        <NavigationBar />
        <main>
            <div id="tag-container">
                <PageTitle title={"#"+ tag}/>
                <div id="tag-list">
                    <ul id="list-of-blogposts">
                        {
                            posts.map((post) => (
                                <li class="shadow border-radius">
                                    <a
                                        class="link-to-blogpost"
                                        href={`/blog/${post.id}`}
                                    >
                                        <span class="date-for-blogpost">
                                            <FormattedDate
                                                date={post.data.pubDate}
                                            />
                                        </span>
                                        <span class="title-for-blogpost">
                                            {post.data.title}
                                        </span>
                                    </a>
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </div>
        </main>
        <Footer />
        <style>
            #tag-container {
                margin: 0 auto;
                max-width: 960px;
                /* padding-top: 10rem; */
                /* height: calc(100vh - 16rem); */
                /* height: 100vh; */
                /* text-align: center; */
            }
            ul {
                padding: 0; /* Remove padding */
                margin: 0; /* Remove margins */
            }
            #tag-list {
                margin-left: 6px;
            }
            ul {
                /* display: flex; */
                /* flex-flow: row wrap; */
                /* align-items: stretch; */
                /* justify-content: stretch; */
                /* align-items: center; */
                list-style-type: none;
                cursor: pointer;
                /* line-height: 2rem; */
            }
            .link-to-blogpost {
                text-decoration: none;

                display: flex;
                justify-content: left;
                padding: 1rem;

                & .date-for-blogpost {
                    margin: 0 1rem 0 0;
                }
            }
            .link-to-blogpost:hover {
                background-color: var(--color-primary);
                color: var(--color-secondary);
                //border: 1px solid var(--color-primary);
            }
            li {
                /* width: 200px; */
                /* height: 35px; */
                /* height: 6rem; */
                padding: 0.5rem;
                margin: 0.5rem;
                /* flex-grow: 1; */
                /* display: flex; */
                /* flex-direction: column; */
                /* background: grey; */
            }
        </style>
    </body>
</html>
