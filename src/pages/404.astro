---
import { BLOG_NAME } from "@consts";
import Wrapper from "@ui/Wrapper.astro";
import PageTitle from "@ui/PageTitle.astro";
import NoIndexLayout from "@layouts/NoIndexLayout.astro";
const title = {BLOG_NAME} + " - Seite nicht gefunden"
---
<NoIndexLayout title={title} description={title}>
    <main>
        <Wrapper>
            <article>
                <PageTitle title="Seite nicht gefunden"/>
            </article>
        </Wrapper>
    </main>
</NoIndexLayout>
