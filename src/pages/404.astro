---
import { BLOG_NAME } from "@consts";
import Wrapper from "@components/design-system/Wrapper.astro";
import MainLayout from "@layouts/MainLayout.astro";
import PageTitle from "@components/design-system/PageTitle.astro";
import Meta from "@components/Meta.astro";
const title = {BLOG_NAME} + " - Seite nicht gefunden"
---
<html>
    <head>
        <title>{title}</title>
        <Meta description={title} title={title} />
        <meta content="noindex" name="robots"/>
    </head>
    <body data-pagefind-ignore>
        <Wrapper>
            <article>
                <PageTitle title="Seite nicht gefunden"/>
            </article>
        </Wrapper>
    </body>
</html>
