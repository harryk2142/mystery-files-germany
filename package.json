{
  "name": "mystery-files-germany",
  "type": "module",
  "version": "1.1.0",
  "engines": {
    "node": ">=26.3.0"
  },
  "scripts": {
    "dev": "concurrently \"astro dev\" \"firebase emulators:start\"",
    "build": "astro build",
    "list-globals": "pnpm list -g",
    "generate:favicons": "tsx scripts/generateFavicons.ts",
    "generate:blogpostImages": "tsx scripts/generateBlogpostImages.ts",
    "preview": "astro preview",
    "astro": "astro",
    "astro:sync": "astro sync",
    "astro:check": "astro check",
    "show-outdated": "pnpm outdated",
    "update-latest": "pnpm update --latest",
    "format": "biome format --write",
    "format:check": "biome format --check",
    "lint": "biome lint .",
    "check": "biome check ",
    "biome:check:write": "biome check --write .",
    "style:lint": "stylelint --fix \"**/*.{css,astro}\"",
    "list-global": "pnpm list -g --depth 0",
    "export-firestore:prod": "tsx --env-file=.env scripts/import-export/exportData.ts",
    "export-firestore:dev": "tsx --env-file=.env.dev scripts/import-export/exportData.ts",
    "import-firestore:prod": "tsx --env-file=.env scripts/import-export/importData.ts",
    "import-firestore:dev": "tsx --env-file=.env.dev scripts/import-export/importData.ts",
    "migrate-data": "tsx scripts/import-export/migrateData.ts",
    "deploy": "firebase deploy"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.0",
    "@astrojs/mdx": "7.0.0",
    "@astrojs/preact": "6.0.0",
    "@astrojs/rss": "4.0.18",
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/ts-plugin": "1.10.9",
    "@firebase/firestore": "4.16.0",
    "@nanostores/preact": "1.1.0",
    "astro": "7.0.3",
    "astro-rehype-relative-markdown-links": "0.19.0",
    "firebase": "12.15.0",
    "nanostores": "1.4.0",
    "preact": "10.29.3",
    "sharp": "0.35.2",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@biomejs/biome": "2.5.1",
    "@stylistic/stylelint-plugin": "5.2.0",
    "astro-pagefind": "2.0.0",
    "concurrently": "10.0.3",
    "dotenv": "17.4.2",
    "firebase-admin": "14.1.0",
    "postcss-html": "1.8.1",
    "stylelint": "17.14.0",
    "stylelint-config-alphabetical-order": "2.0.0",
    "stylelint-config-astro": "2.0.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-order": "8.1.1",
    "tasuku": "2.3.0",
    "tsx": "4.22.4",
    "vite-plugin-qrcode": "0.4.1"
  }
}
